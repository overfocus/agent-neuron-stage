// goodnight — two of them, in pencil, at the speed of someone falling asleep.
// Nothing happens twice, and the last line is not a punchline.
{
  title: "goodnight",
  bpm: 64,
  beatsPerBar: 4,
  tail: 4.2,
  events: [
    { at: [1, 1], enter: { id: "big", who: "girl", x: -0.8, z: 0.05 } },
    { at: [1, 1], enter: { id: "small", who: "child", x: 0.8, z: 0 } },
    { at: [1, 2], style: "sketch" },
    { at: [1, 3], shot: "medium", on: "small" },
    { at: [2, 1], pose: "eyes-sleepy", on: "small" },
    { at: [2, 2], say: "One more page.", on: "small" },
    { at: [3, 1], shot: "medium", on: "big" },
    { at: [3, 2], pose: "at-ease", on: "big" },
    { at: [3, 3], say: "The page is finished.", on: "big" },
    { at: [4, 1], shot: "close", on: "small" },
    { at: [4, 2], pose: "mouth-yawn", on: "small" },
    { at: [4, 3], say: "Then read it again.", on: "small" },
    { at: [5, 1], shot: "medium", on: "big" },
    { at: [5, 2], pose: "feel-laughing", on: "big" },
    { at: [5, 3], say: "Again, then.", on: "big" },
    { at: [6, 1], shot: "medium", on: "small" },
    { at: [6, 1], pose: "feel-sad", on: "small" },
    { at: [7, 1], shot: "wide" },
    { at: [7, 1], pose: "hands-rest", on: "big" },
    { at: [7, 2], pose: "feel-bored", on: "small" },
    { at: [8, 3], end: { text: "GOODNIGHT" } },
  ],
}
