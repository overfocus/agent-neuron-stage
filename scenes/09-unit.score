// unit — five of them, on an oscilloscope, moving like machines: heavy, still
// between commands, and every pose landing on the same beat for all of them.
{
  title: "unit",
  bpm: 120,
  beatsPerBar: 4,
  tail: 2.6,
  events: [
    { at: [1, 1], enter: { id: "u1", who: "max", x: -2.4, z: 0.2 } },
    { at: [1, 1], enter: { id: "u2", who: "boss", x: -1.2, z: 0.1 } },
    { at: [1, 1], enter: { id: "u3", who: "professor", x: 0, z: 0 } },
    { at: [1, 1], enter: { id: "u4", who: "clerk", x: 1.2, z: 0.1 } },
    { at: [1, 1], enter: { id: "u5", who: "teen", x: 2.4, z: 0.2 } },
    { at: [1, 1], manner: { weight: 1, idle: "still" }, on: "u1" },
    { at: [1, 1], manner: { weight: 1, idle: "still" }, on: "u2" },
    { at: [1, 1], manner: { weight: 1, idle: "still" }, on: "u3" },
    { at: [1, 1], manner: { weight: 1, idle: "still" }, on: "u4" },
    { at: [1, 1], manner: { weight: 1, idle: "still" }, on: "u5" },
    { at: [1, 2], style: "oscilloscope" },
    { at: [1, 3], shot: "wide" },
    { at: [2, 1], pose: "stop", on: "u1" },
    { at: [2, 1], pose: "stop", on: "u2" },
    { at: [2, 1], pose: "stop", on: "u3" },
    { at: [2, 1], pose: "stop", on: "u4" },
    { at: [2, 1], pose: "stop", on: "u5" },
    { at: [3, 1], pose: "point", on: "u1" },
    { at: [3, 1], pose: "point", on: "u2" },
    { at: [3, 1], pose: "point", on: "u3" },
    { at: [3, 1], pose: "point", on: "u4" },
    { at: [3, 1], pose: "point", on: "u5" },
    { at: [3, 2], say: "Unit.", on: "u3" },
    { at: [4, 1], shot: "medium", on: "u3" },
    { at: [4, 1], pose: "eyes-wide", on: "u3" },
    { at: [4, 2], say: "State your deviation.", on: "u3" },
    { at: [5, 1], shot: "close", on: "u5" },
    { at: [5, 1], pose: "eyes-suspicious", on: "u5" },
    { at: [5, 2], say: "I have a name.", on: "u5" },
    { at: [6, 1], shot: "wide" },
    { at: [6, 1], pose: "eyes-x", on: "u1" },
    { at: [6, 1], pose: "eyes-x", on: "u2" },
    { at: [6, 1], pose: "eyes-x", on: "u4" },
    { at: [7, 1], shot: "close", on: "u3" },
    { at: [7, 1], pose: "eyes-sleepy", on: "u3" },
    { at: [7, 2], say: "Noted.", on: "u3" },
    { at: [8, 2], end: { text: "UNIT" } },
  ],
}
