// a walk — three of them, and the whole scene is distance. One comes in from
// outside the frame, two are already in the room, and by the end they have all
// changed places without anybody leaving. Every move here is the stage's own
// command: a place, or a step from where the body stands, over a number of
// beats (docs/SCORE.md, "Walking").
{
  title: "a walk",
  bpm: 90,
  beatsPerBar: 4,
  tail: 4,
  events: [
    // the two already here are framed first, so ann's entrance is off-frame
    { at: [1, 1], enter: { id: "bo", who: "oldman", x: 3.4, z: 1.6 } },
    { at: [1, 1], enter: { id: "kit", who: "clerk", x: 0.2, z: -1.1 } },
    { at: [1, 1], shot: "wide", on: ["bo", "kit"] },
    { at: [1, 1], enter: { id: "ann", who: "girl", x: -9, z: 1.9 } },
    { at: [1, 2], style: "sketch" },

    // and she walks in from the left, the whole width of the room
    { at: [1, 4], move: { x: -0.9, z: 0.5 }, over: 4, on: "ann" },
    { at: [2, 4], move: { dx: -2.4, dz: 0.5 }, over: 2, on: "kit" },

    { at: [4, 1], shot: "medium", on: "bo" },
    { at: [4, 1], say: "You walked all that way.", on: "bo" },

    // she takes one pace closer; he does not
    { at: [4, 3], move: { dx: 0.5, dz: -0.3 }, over: 1.5, on: "ann" },
    { at: [4, 4], shot: "medium", on: "ann" },
    { at: [4, 4], say: "You didn't.", on: "ann" },

    // the one in front steps back into the depth, and says so
    { at: [5, 2], move: { z: 2.4 }, over: 2, on: "kit" },
    { at: [5, 3], shot: "wide" },
    { at: [5, 4], say: "I'll watch from here.", on: "kit" },

    // and he leaves the middle the way he came, without turning round
    { at: [6, 1], move: { x: 2.6, z: 1.4 }, over: 2, on: "bo" },
    { at: [6, 3], say: "Then we're even.", on: "bo" },

    { at: [7, 1], shot: "full", on: "ann" },
    { at: [7, 1], pose: "feel-sulking", on: "ann" },
    { at: [7, 1], say: "Nobody is even.", on: "ann" },
    { at: [8, 1], shot: "wide" },
    { at: [8, 2], end: { text: "A WALK" } }
  ]
}
