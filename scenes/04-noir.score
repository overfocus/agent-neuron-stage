// noir — two of them and a letter, in ink. Nothing is said above a murmur,
// and the light is the wrong side of the frame on purpose.
{
  title: "noir",
  bpm: 72,
  beatsPerBar: 4,
  tail: 3.8,
  events: [
    { at: [1, 1], enter: { id: "her", who: "girl", x: -1.1, z: 0.08 } },
    { at: [1, 1], enter: { id: "him", who: "oldman", x: 1.1, z: 0 } },
    { at: [1, 2], style: "inkpunch" },
    { at: [1, 3], shot: "medium", on: "her" },
    { at: [2, 1], pose: "secret", on: "her" },
    { at: [2, 2], say: "You did not get this from me.", on: "her" },
    { at: [3, 1], shot: "close", on: "him" },
    { at: [3, 2], pose: "eyes-suspicious", on: "him" },
    { at: [3, 3], say: "I did not get it at all.", on: "him" },
    { at: [4, 1], shot: "medium", on: "her" },
    { at: [4, 1], pose: "letter", on: "her" },
    { at: [4, 3], say: "Then read it twice.", on: "her" },
    { at: [5, 1], shot: "close", on: "him" },
    { at: [5, 1], pose: "eyes-down", on: "him" },
    { at: [5, 2], pose: "feel-sad", on: "him" },
    { at: [5, 3], say: "It is my handwriting.", on: "him" },
    { at: [6, 1], shot: "wide" },
    { at: [6, 1], pose: "turn-to", on: "her" },
    { at: [6, 2], pose: "facepalm", on: "him" },
    { at: [7, 3], end: { text: "NOIR" } },
  ],
}
