{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "maxcot": ["./vendor/maxcot/src/index.ts"],
      "maxcot/*": ["./vendor/maxcot/src/*/index.ts"]
    }
  },
  "include": ["src", "test", "spikes", "vite.config.ts"]
}
