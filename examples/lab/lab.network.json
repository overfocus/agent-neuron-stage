{
  "version": 0,
  "name": "the lab",
  "description": "Seven scientists in a lab at 2am, arguing about the Riemann hypothesis. Nobody is called on: the question goes to all seven, every answer goes to whoever that scientist talks to, and each one decides for itself whether to take the floor - so the conversation wanders instead of taking turns. Their places span a bigger room (x from -5.6 to 5.2, z from -1.2 to 3.7), and every speaker walks as it talks: the near ones give ground, the far ones come down out of the dark at the back.",
  "neurons": [
    {
      "id": "cue",
      "source": true,
      "at": [
        -7.2,
        0,
        0.6
      ],
      "description": "The question the room is asked: whoever holds the stage says it once, and the whole lab hears it."
    },
    {
      "id": "ada",
      "run": [
        "node",
        "mind/ada.mjs"
      ],
      "timeout": 20000,
      "maxHops": 4,
      "at": [
        -4.2,
        0,
        -1.2
      ],
      "may": {
        "connect": [
          "127.0.0.1:11434"
        ]
      },
      "description": "Ada, at the near bench and closest to certainty: an analytic number theorist who will not take a hunch for evidence."
    },
    {
      "id": "jules",
      "run": [
        "node",
        "mind/jules.mjs"
      ],
      "timeout": 20000,
      "maxHops": 4,
      "at": [
        -1.8,
        0,
        -0.6
      ],
      "may": {
        "connect": [
          "127.0.0.1:11434"
        ]
      },
      "description": "Jules, in the middle of the floor: not a number theorist and not shy about asking what any of it pays for."
    },
    {
      "id": "rosa",
      "run": [
        "node",
        "mind/rosa.mjs"
      ],
      "timeout": 20000,
      "maxHops": 4,
      "at": [
        2.4,
        0,
        -1.0
      ],
      "may": {
        "connect": [
          "127.0.0.1:11434"
        ]
      },
      "description": "Rosa, at the far bench: she trusts counts and bounds, has checked more zeros than anyone here, and says it proves nothing."
    },
    {
      "id": "bruno",
      "run": [
        "node",
        "mind/bruno.mjs"
      ],
      "timeout": 20000,
      "maxHops": 4,
      "at": [
        6.8,
        0,
        0.8
      ],
      "may": {
        "connect": [
          "127.0.0.1:11434"
        ]
      },
      "description": "Bruno, out at the edge of the light: he hears the zeros as a chord and overclaims in images."
    },
    {
      "id": "iris",
      "run": [
        "node",
        "mind/iris.mjs"
      ],
      "timeout": 20000,
      "maxHops": 4,
      "at": [
        4.6,
        0,
        2.8
      ],
      "may": {
        "connect": [
          "127.0.0.1:11434"
        ]
      },
      "description": "Iris, back by the shelves: a historian of mathematics who dates every claim and corrects the record."
    },
    {
      "id": "otto",
      "run": [
        "node",
        "mind/otto.mjs"
      ],
      "timeout": 20000,
      "maxHops": 4,
      "at": [
        0.4,
        0,
        3.9
      ],
      "may": {
        "connect": [
          "127.0.0.1:11434"
        ]
      },
      "description": "Otto, deepest at the back: a physicist who hears random matrices in the zeros and reaches for analogy before proof."
    },
    {
      "id": "lea",
      "run": [
        "node",
        "mind/lea.mjs"
      ],
      "timeout": 20000,
      "maxHops": 4,
      "at": [
        -5.4,
        0,
        3.0
      ],
      "may": {
        "connect": [
          "127.0.0.1:11434"
        ]
      },
      "description": "Lea, back left with the chalk: a formalist who wants to know what 'true' is supposed to mean here."
    }
  ],
