{
  "version": 0,
  "name": "kes-inner",
  "description": "The inner life of kes. Hot-tempered and slow to forgive; keeps to the pass on the dark side.",
  "neurons": [
    {
      "id": "senses",
      "description": "What the stage tells this character: time passing, who is near, where it stands, and what was done to it.",
      "source": true,
      "at": [
        -200,
        0,
        0
      ]
    },
    {
      "id": "hunger",
      "description": "Rises with time; eating brings it down. Feeds anger and lowers happiness.",
      "serve": [
        "node",
        "../mind/drive.mjs",
        "hunger"
      ],
      "maxHops": 6,
      "timeout": 5000,
      "at": [
        100,
        0,
        0
      ]
    },
    {
      "id": "loneliness",
      "description": "Rises while nobody is near; company and kindness bring it down.",
      "serve": [
        "node",
        "../mind/drive.mjs",
        "loneliness",
        "need=0.5"
      ],
      "maxHops": 6,
      "timeout": 5000,
      "at": [
        62,
        78,
        0
      ]
    },
    {
      "id": "anger",
      "description": "A hurt raises it, an empty stomach and a grudge feed it, saying it to their face lets it go.",
      "serve": [
        "node",
        "../mind/drive.mjs",
        "anger",
        "temper=1.6",
        "calm=0.6"
      ],
      "maxHops": 6,
      "timeout": 5000,
      "at": [
        -22,
        97,
        0
      ]
    },
    {
      "id": "resentment",
      "description": "A grudge per person, from every hurt; it fades slowly, and grows near them while angry. The memory.",
      "serve": [
        "node",
        "../mind/drive.mjs",
        "resentment",
        "grudge=1.6",
        "forgive=0.35"
      ],
      "maxHops": 6,
      "timeout": 5000,
      "at": [
        -90,
        43,
        0
      ]
    },
    {
      "id": "fear",
      "description": "A fright raises it, the dark side of the room keeps it up; company calms it.",
      "serve": [
        "node",
        "../mind/drive.mjs",
        "fear",
        "nerve=0.5"
      ],
      "maxHops": 6,
      "timeout": 5000,
      "at": [
        -90,
        -43,
        0
      ]
    },
    {
      "id": "happiness",
      "description": "Drifts toward its cheer, pulled down by every other drive.",
      "serve": [
        "node",
        "../mind/drive.mjs",
        "happiness",
        "cheer=0.4"
      ],
      "maxHops": 6,
      "timeout": 5000,
      "at": [
        -22,
        -97,
        0
      ]
    },
    {
      "id": "desire",
      "description": "Longs for one place in the room; being there satisfies it.",
      "serve": [
        "node",
        "../mind/drive.mjs",
        "desire",
        "longing=1",
        "place=E"
      ],
      "maxHops": 6,
      "timeout": 5000,
      "at": [
        62,
        -78,
        0
      ]
    },
    {
      "id": "will",
      "description": "Hears every drive and says what the character means to do, as a cue (say, pose) and an intent.",
      "serve": [
        "node",
        "../mind/will.mjs"
      ],
      "maxHops": 6,
      "timeout": 5000,
      "at": [
        200,
        0,
        0
      ]
    }
  ],
